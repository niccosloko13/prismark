NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/prismarq?sslmode=verify-full
DATABASE_SSL=false
DATABASE_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=prismarq_session
SESSION_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

BCRYPT_SALT_ROUNDS=12

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_EXTENSIONS=.svg,.png,.jpg,.jpeg,.pdf,.zip,.ai,.cdr
ALLOWED_UPLOAD_MIME_TYPES=image/svg+xml,image/png,image/jpeg,application/pdf,application/zip,application/postscript,application/octet-stream

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
